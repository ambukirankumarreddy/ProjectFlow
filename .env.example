# ==============================================================================
# ProjectFlow AI - Enterprise Environment Configuration Template
# IMPORTANT: Never commit actual production secrets or private keys to source control.
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_PORT=5000
FRONTEND_URL=http://localhost:5174
API_BASE_URL=http://localhost:5000/api/v1

# Security & Session Authentication
JWT_SECRET=your-256-bit-jwt-secret-key-placeholder-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-placeholder
SESSION_COOKIE_SECRET=your-cookie-secret-placeholder

# Google Workspace OAuth 2.0 Credentials
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret-placeholder
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
ALLOWED_ORG_DOMAIN=edgeforce.in

# Organization & Super Admin Registration Defaults
SUPER_ADMIN_EMAIL=superadmin@edgeforce.in
DEFAULT_ORGANIZATION_NAME=Edgeforce Defense & Aerospace Solutions

# Database Connection (PostgreSQL / Supabase)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projectflow_ai_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DATABASE_URL=postgresql://postgres:your_secure_db_password@localhost:5432/projectflow_ai_db?schema=public

# Indian Localization & Currency
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
DEFAULT_TIMEZONE=Asia/Kolkata
FINANCIAL_YEAR_START_MONTH=4

# Real-Time WebSocket Server
WS_PORT=5001
WS_CORS_ORIGIN=http://localhost:5174

# Email & Notification Transports (SMTP / SendGrid / SES)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@edgeforce.in
SMTP_PASS=smtp_password_placeholder
FROM_EMAIL="ProjectFlow AI Alerts" <notifications@edgeforce.in>

# File Storage & Attachments (AWS S3 / GCP Storage / MinIO)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=edgeforce-projectflow-assets
